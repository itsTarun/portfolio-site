# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnp.js
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.opencode/
# A stray Python virtualenv. Only invisible before because the old blanket
# `*.md` rule happened to swallow the one tracked-looking file inside it.
.venv/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .md — scratch notes at the repo root only. Nested markdown (docs/**, src/**)
# is tracked; a bare `*.md` here silently swallowed every new file under them.
/*.md
!/README.md
!/CLAUDE.md
!/REDESIGN.md
!/PRODUCT.md

# Internal working material. The repo is public and linked from the site's
# header, footer and Person schema — a client browsing it should not land on a
# personal bug tracker, WIP plans, or screenshots of pages that no longer exist.
# These stay on disk; they just stop being published.
docs/screenshots/
docs/plans/
docs/superpowers/
docs/ISSUES_PROGRESS.md
src/prompts/
.impeccable/
.repopress/
